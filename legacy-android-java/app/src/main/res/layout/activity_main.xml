<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
              android:layout_width="match_parent"
              android:layout_height="match_parent"
              android:orientation="vertical"
              android:padding="16dp"
              android:background="#F4F6F8">

    <!-- Encabezado / Tarjeta de Saldo -->
    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:background="#003366"
            android:elevation="4dp"
            android:layout_marginBottom="20dp">

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MiSaldito - Banco del Pacífico"
                android:textColor="#FFFFFF"
                android:textSize="14sp" />

        <TextView
                android:id="@+id/tvSaldoActual"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$0.00"
                android:textColor="#FFFFFF"
                android:textSize="32sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />

        <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Saldo disponible para recargas/pagos"
                android:textColor="#D0E1F9"
                android:textSize="12sp"
                android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Título de la lista -->
    <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Últimos Movimientos y Recargas"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="#333333"
            android:layout_marginBottom="10dp" />

    <!-- Lista Dinámica de Transacciones (RecyclerView) -->
    <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvMovimientos"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

</LinearLayout>